# URL publique du site (sans / final). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Printify : Mon compte > Connections > API tokens (droits shops, products, orders)
PRINTIFY_API_TOKEN=
# Identifiant de la boutique "API / Custom integration" (voir README pour le trouver)
PRINTIFY_SHOP_ID=
# true = la commande part directement en production chez l'imprimeur
# false = elle reste "On hold" dans Printify jusqu'à ce que tu la valides
PRINTIFY_AUTO_PRODUCTION=false

# Stripe : Developers > API keys, et Developers > Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frais de livraison facturés au client, en centimes (490 = 4,90 €)
SHIPPING_CENTS=490
